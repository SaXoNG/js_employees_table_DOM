"use strict";
document.addEventListener("DOMContentLoaded", function() {
    var table = document.querySelector("table");
    var headers = Array.from(table.querySelectorAll("thead th"));
    var rows = Array.from(table.querySelectorAll("tbody tr"));
    var sortDirection = {};
    var isNumeric = function(str) {
        var cleanedStr = str.replace(/[^0-9.-]/g, "").trim();
        return !isNaN(parseFloat(cleanedStr)) && isFinite(cleanedStr);
    };
    var sortTable = function(columnIndex) {
        var compare = function(a, b) {
            var valA = a.children[columnIndex].textContent.trim();
            var valB = b.children[columnIndex].textContent.trim();
            if (isNumeric(valA) && isNumeric(valB)) {
                var numA = parseFloat(valA.replace(/[^0-9.-]/g, "").trim());
                var numB = parseFloat(valB.replace(/[^0-9.-]/g, "").trim());
                return numA - numB;
            }
            return valA.localeCompare(valB);
        };
        var currentDirection = sortDirection[columnIndex] || "ascending";
        rows.sort(function(a, b) {
            var result = compare(a, b);
            return currentDirection === "ascending" ? result : -result;
        });
        sortDirection[columnIndex] = currentDirection === "ascending" ? "descending" : "ascending";
        var tbody = table.querySelector("tbody");
        tbody.innerHTML = "";
        rows.forEach(function(row) {
            return tbody.appendChild(row);
        });
    };
    headers.forEach(function(header, index) {
        header.addEventListener("click", function() {
            sortTable(index);
        });
    });
    rows.forEach(function(row) {
        row.addEventListener("click", function() {
            rows.forEach(function(r) {
                return r.classList.remove("active");
            });
            row.classList.add("active");
        });
    });
    var createdFormField = document.createElement("form");
    var createdButton = document.createElement("button");
    var selectTagOptions = [
        "Tokyo",
        "Singapore",
        "London",
        "New York",
        "Edinburgh",
        "San Francisco"
    ];
    createdFormField.setAttribute("class", "new-employee-form");
    createdButton.textContent = "Save to table";
    headers.forEach(function(header) {
        var newLabel = document.createElement("label");
        var newElement;
        if (header.textContent !== "Office") newElement = document.createElement("input");
        else {
            newElement = document.createElement("select");
            selectTagOptions.forEach(function(option) {
                var newOption = document.createElement("option");
                newOption.textContent = option;
                newElement.append(newOption);
            });
        }
        newElement.setAttribute("type", header.textContent === "Age" || header.textContent === "Salary" ? "number" : "text");
        newElement.setAttribute("data-qa", header.textContent.toLowerCase());
        newElement.setAttribute("name", header.textContent.toLowerCase());
        newElement.setAttribute("class", "cell-input ".concat(header.textContent.toLowerCase()));
        newLabel.textContent = "".concat(header.textContent, ":");
        newLabel.append(newElement);
        createdFormField.append(newLabel);
    });
    var validateForm = function() {
        var inputNameValue = document.querySelector(".name").value.trim();
        var inputPositionValue = document.querySelector(".position").value.trim();
        var inputAgeValue = document.querySelector(".age").value.trim();
        var inputSalaryValue = document.querySelector(".salary").value.trim();
        if (inputNameValue.length < 4) {
            pushNotification("Invalid Input", "Name must be at least 4 characters", "error");
            return false;
        } else if (inputPositionValue.length === 0) {
            pushNotification("Invalid Input", "Position cannot be empty", "error");
            return false;
        } else if (Number(inputAgeValue) < 18 || Number(inputAgeValue) > 90) {
            pushNotification("Invalid Age", "Age must be between 18 and 90", "error");
            return false;
        } else if (inputSalaryValue.length < 1) {
            pushNotification("Invalid Salary", "Salary cannot be empty", "error");
            return false;
        }
        return true;
    };
    createdButton.addEventListener("click", function(e) {
        e.preventDefault();
        if (!validateForm()) return;
        var allLabels = Array.from(document.querySelectorAll("label"));
        var newRow = document.createElement("tr");
        allLabels.forEach(function(label) {
            var newTd = document.createElement("td");
            var value = label.lastChild.value;
            if (label.textContent === "Salary:") newTd.textContent = "$".concat(Number(value).toLocaleString("en-US"));
            else newTd.textContent = value;
            newRow.append(newTd);
        });
        pushNotification("Employee Added", "New employee data saved successfully", "success");
        document.querySelector("tbody").append(newRow);
        rows.push(newRow);
        allLabels.forEach(function(item) {
            return item.lastChild.value = "";
        });
        document.querySelector("select").firstElementChild.selected = true;
    });
    document.body.append(createdFormField);
    createdFormField.append(createdButton);
});
var pushNotification = function(title, description, type) {
    var createdElement = document.createElement("div");
    var notificationTitle = document.createElement("h2");
    var notificationMessage = document.createElement("p");
    notificationTitle.textContent = title;
    notificationMessage.textContent = description;
    notificationTitle.setAttribute("class", "title");
    createdElement.setAttribute("class", "notification ".concat(type));
    createdElement.append(notificationTitle);
    createdElement.append(notificationMessage);
    document.body.append(createdElement);
    setTimeout(function() {
        createdElement.style.display = "none";
    }, 2000);
};

